# ==============================================================================
# SIT Scholarship Application Portal - Environment Variables Template
# Copy this file to .env.local and populate with your secure credentials
# Supabase Region: ap-south-1 (Mumbai, India)
# ==============================================================================

NODE_ENV=
PORT=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# Supabase Auth, PostgreSQL & Storage (Region: Mumbai ap-south-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AES-256-GCM Bank Account Encryption (32 random bytes, base64)
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=

# Bootstrap Admin Script (Only when running scripts/create-admin.ts; never store credentials here)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# College Portal Metadata
NEXT_PUBLIC_COLLEGE_NAME="Siddaganga Institute of Technology"
NEXT_PUBLIC_COLLEGE_LOCATION="Tumakuru – 572103, Karnataka"

# Cycle Dates (Optional override; defaults configured in code)
CYCLE_OPEN_DATE=
CYCLE_CLOSE_DATE=

# Test Supabase Environment (Used only by test suite - MUST be a separate test project)
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SECRET_KEY=
