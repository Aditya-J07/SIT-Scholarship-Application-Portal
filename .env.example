# ==============================================================================
# SIT Scholarship Application Portal - Environment Variables Template
# Copy this file to .env.local and populate with your secure credentials
# Supabase Region: ap-south-1 (Mumbai, India)
#
# IMPORTANT BUILD-TIME NOTE:
# In Next.js, all variables prefixed with NEXT_PUBLIC_ are baked into the client-side
# JavaScript bundle at build time (`npm run build`). If any NEXT_PUBLIC_* variable is
# changed or added in your hosting environment (e.g. Vercel), the project MUST be
# rebuilt (`npm run build`) for the changes to take effect in the browser.
# ==============================================================================

NODE_ENV=
PORT=

# Application & Site Canonical URLs (NEXT_PUBLIC_* are baked in at build time)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# Supabase Auth, PostgreSQL & Storage (Region: Mumbai ap-south-1)
# (NEXT_PUBLIC_SUPABASE_* are baked into client bundles at build time)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AES-256-GCM Bank Account Encryption (32 random bytes, base64)
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=

# Keyed HMAC-SHA256 for bank account duplicate checking
HASH_KEY=

# Bootstrap Admin Script (Only when running scripts/create-admin.ts; never store credentials here)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# College Portal Metadata (Baked in at build time)
NEXT_PUBLIC_COLLEGE_NAME="Siddaganga Institute of Technology"
NEXT_PUBLIC_COLLEGE_LOCATION="Tumakuru – 572103, Karnataka"

# Test Supabase Environment (Used only by test suite - MUST be a separate test project)
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SECRET_KEY=
# Set to 1 only while the single Supabase project holds no real data; remove before launch. Strictly fails in NODE_ENV=production.
ALLOW_SAME_PROJECT_TEST=

# Vercel Cron Secret (Secures /api/cron/cleanup-rate-limits)
CRON_SECRET=

# Cloudflare Turnstile CAPTCHA (H5)
# (NEXT_PUBLIC_TURNSTILE_SITE_KEY is baked into client bundles at build time)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Application Email Notifications (SMTP via Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SIT Scholarships <TODO_SENDER_EMAIL>"
