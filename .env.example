# ==============================================================================
# SIT Scholarship Application Portal - Environment Variables Template
# Copy this file to .env.local and populate with your secure credentials
# Region: ap-south-1 (Mumbai, India)
# ==============================================================================

NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security Secrets (Must be at least 32 characters, cryptographically random)
JWT_SECRET=
ENCRYPTION_KEY=

# Supabase PostgreSQL & Cloud Storage (Region: Mumbai ap-south-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# College Portal Metadata
NEXT_PUBLIC_COLLEGE_NAME="Siddaganga Institute of Technology"
NEXT_PUBLIC_COLLEGE_LOCATION="Tumakuru – 572103, Karnataka"

# Cycle Dates (Optional override; defaults to official circular dates)
CYCLE_OPEN_DATE=
CYCLE_CLOSE_DATE=
